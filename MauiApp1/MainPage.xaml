<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.MainPage"
             >
    <Grid BackgroundColor="{AppThemeBinding Dark=#ffffff, Light=#dfdfdf}">
        <Grid ColumnDefinitions="4*, 20*, 34*"
              RowDefinitions="*, Auto"
              ColumnSpacing="5"
              RowSpacing="5">
            <Grid Grid.Column="0"
                  BackgroundColor="{AppThemeBinding Dark=#ffffff, Light=#dfdfdf}"
                  RowDefinitions="*, auto, auto"
                    RowSpacing="6">
                <Border Margin="5, 5, 0, 0" Grid.Row="0" BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#2f2f2f}" Stroke="{AppThemeBinding Light=Black, Dark=White}" StrokeShape="RoundRectangle 10" WidthRequest="80">
                    <CollectionView
                        SelectionMode="Single"
                        x:Name="AppCollectionView"
                        SelectionChanged="AppCollectionView_SelectionChanged"
                        HorizontalOptions="Fill"
                        >
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <StackLayout Padding="0,5,0,0">
                                    <Border VerticalOptions="Center" Stroke="{AppThemeBinding Light=Black, Dark=White}" StrokeShape="RoundRectangle 10" HeightRequest="48" WidthRequest="48">
                                        <Label
                                            Text="{Binding Shortcut}"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                            IsVisible="True"/>
                                    </Border>
                                </StackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
                <Border Margin="5,0,0,0" Grid.Row="1" BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#2f2f2f}" Stroke="{AppThemeBinding Light=Black, Dark=White}" StrokeShape="RoundRectangle 10">
                    <ImageButton
                            Aspect="AspectFit"
                            HeightRequest="65" 
                            WidthRequest="65"
                            Clicked="AddApp_Clicked"
                            BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#2f2f2f}"
                            >
                        <ImageButton.Source>
                            <FontImageSource
                                    FontFamily="MaterialIcons"
                                    Glyph="&#xe145;"
                                    Color="{AppThemeBinding Light=Black, Dark=White}"
                                    Size="24" />
                        </ImageButton.Source>
                    </ImageButton>
                </Border>
                <Border Margin="5,0,0,0" Grid.Row="2" BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#2f2f2f}" Stroke="{AppThemeBinding Light=Black, Dark=White}" StrokeShape="RoundRectangle 10">
                    <ImageButton
                        Aspect="AspectFit"
                        HeightRequest="65" 
                        WidthRequest="65"
                        Clicked="OpenPopupSettings_Clicked"
                        BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#2f2f2f}"
                        >
                        <ImageButton.Source>
                            <FontImageSource
                                FontFamily="MaterialIcons"
                                Glyph="&#xf522;"
                                Color="{AppThemeBinding Light=Black, Dark=White}"
                                Size="24" />
                        </ImageButton.Source>
                    </ImageButton>
                </Border>
            </Grid>
            <Border Margin="0,5,0,0" Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#2f2f2f}" Stroke="{AppThemeBinding Light=Black, Dark=White}" StrokeShape="RoundRectangle 10">
                <Grid
                    RowDefinitions="48*, 8*, 6*, 20*, 3*, 2*"
                    RowSpacing="10"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#0c0c0c}"
                    Padding="0"
                    Margin="5,0,5,20"
                    x:Name="DetailsGrid"
                    IsVisible="False">
                    <Border
                        BackgroundColor="White" 
                        HorizontalOptions="Center"
                        Padding="0"
                        Margin="0,20,0,10"
                        Grid.Row="0">
                        <Image
                                x:Name="gameBanner"
                                Source="nimo.png"        
                        />
                    </Border>

                    <!-- ą, ć, ę, ł, ń, ó, ś, ź, ż -->
                    <HorizontalStackLayout Spacing="5" Grid.Row="1">
                        <Button Text="Stwórz kopię zapisów" TextColor="{AppThemeBinding Light=Black, Dark=White}" BackgroundColor="{AppThemeBinding Light=#10000000, Dark=#10ffffff}" FontSize="14">
                            <Button.ImageSource>
                                <FontImageSource
                                    FontFamily="MaterialIcons"
                                    Glyph="&#xe161;"
                                    Size="24"
                                    Color="{AppThemeBinding Light=Black, Dark=White}" />
                            </Button.ImageSource>
                        </Button>
                        <Button Text="Przywróć wybrany zapis" TextColor="{AppThemeBinding Light=Black, Dark=White}" BackgroundColor="{AppThemeBinding Light=#10000000, Dark=#10ffffff}" FontSize="14">
                            <Button.ImageSource>
                                <FontImageSource
                                    FontFamily="MaterialIcons"
                                    Glyph="&#xe929;"
                                    Size="24"
                                    Color="{AppThemeBinding Light=Black, Dark=White}" />
                            </Button.ImageSource>
                        </Button>
                    </HorizontalStackLayout>
                    <VerticalStackLayout HorizontalOptions="Fill" Grid.Row="2">
                        <Grid RowDefinitions="*" ColumnDefinitions="*, 48">
                            <Picker x:Name="BranchPicker" Grid.Column="0"/>
                            <Entry x:Name="BranchEntry" Placeholder="Wprowadź nazwę gałęzi" IsEnabled="False" IsVisible="False" Grid.Column="0"/>
                            <ImageButton
                                HeightRequest="24" WidthRequest="24" VerticalOptions="End" Clicked="SwitchBranch_Clicked" HorizontalOptions="End" Grid.Column="1">
                                <ImageButton.Source>
                                    <FontImageSource
                                            FontFamily="MaterialIcons"
                                            Glyph="&#xe627;"
                                            Color="{AppThemeBinding Light=Black, Dark=White}"
                                            Size="24" />
                                </ImageButton.Source>
                            </ImageButton>
                        </Grid>

                    </VerticalStackLayout>
                    <Border Margin="0,10,0,0" Grid.Row="3">
                        <Label Text="Autozapis" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                    </Border>
                    <VerticalStackLayout Grid.Row="4">
                        <ImageButton
                            HeightRequest="58" WidthRequest="58"  VerticalOptions="End" HorizontalOptions="End" Clicked="OpenPopup_Clicked">
                            <ImageButton.Source>
                                <FontImageSource
                                    FontFamily="MaterialIcons"
                                    Glyph="&#xe8b8;"
                                    Color="{AppThemeBinding Light=Black, Dark=White}"
                                    Size="24" />
                            </ImageButton.Source>
                        </ImageButton>
                    </VerticalStackLayout>

                </Grid>
            </Border>
            <Border Grid.Column="2" Margin="0,5,5,0" BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#2f2f2f}" Stroke="{AppThemeBinding Light=Black, Dark=White}" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout>
                    <Grid BackgroundColor="{AppThemeBinding Light=White, Dark=#0f0f0f}" 
                          Padding="15,10"
                          ColumnDefinitions="*, *, *, *, *">
                        <Label Text="Label" Grid.Column="0" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                        <Label Text="Gra" Grid.Column="1" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                        <Label Text="Data" Grid.Column="2" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                        <Label Text="Czas" Grid.Column="3" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                        <Label Text="Rozmiar" Grid.Column="4" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                    </Grid>

                    <ScrollView>
                        <VerticalStackLayout Padding="10" Spacing="8">
                            <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#0f0f0f}">
                                <Grid ColumnDefinitions="*, *, *, *, *">
                                    <Label Text="Wyginam Śmiało ciało, dla mnie to mało (wgl aktualnie leci mi arabski metal)" Grid.Column="0" TextColor="{AppThemeBinding Light=Black, Dark=White}" HorizontalOptions="Center"/>
                                    <Label Text="Deltarune" Grid.Column="1" TextColor="{AppThemeBinding Light=Black, Dark=White}" HorizontalOptions="Center"/>
                                    <Label Text="12.04.2026" Grid.Column="2" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                                    <Label Text="00:00" Grid.Column="3" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                                    <Label Text="0 MB" Grid.Column="4" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                                </Grid>
                            </Border>

                        </VerticalStackLayout>
                    </ScrollView>

                </VerticalStackLayout>
            </Border>
        </Grid>
        <Grid x:Name="PopupOverlay"
            IsVisible="False"
            BackgroundColor="#80000000"
            ZIndex="10">
            <Button Clicked="ClosePopup_Clicked" BackgroundColor="Transparent"></Button>
            <Border x:Name="PopupContent"
            StrokeThickness="0"
            BackgroundColor="{AppThemeBinding Light=White, Dark=Black}"
            Padding="20"
            StrokeShape="RoundRectangle 12"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            WidthRequest="800">
                <VerticalStackLayout Spacing="10" >
                    <Label Text="Ustawienia" FontSize="20" HorizontalOptions="Center"/>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Nazwa aplikacji: " />
                        <Entry x:Name="name_settings" Placeholder="Nazwa..." Unfocused="Name_Unfocused" HorizontalOptions="Fill"/>
                    </VerticalStackLayout>
                    <Picker x:Name="ProcessPicker" HorizontalOptions="Fill" Title="Wybierz proces..." SelectedIndexChanged="ProcessPicker_SelectedIndexChanged"/>
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Ścieżka pliku wykonywalnego: " VerticalOptions="Center"/>
                        <Entry x:Name="exePathEntry" Placeholder="Ścieżka pliku..." Unfocused="exePathEntry_Unfocused" HorizontalOptions="Fill"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Steam App ID: " VerticalOptions="Center"/>
                        <Entry x:Name="steamAID" Placeholder="Steam APP ID..." Unfocused="steamAIDEntry_Unfocused" HorizontalOptions="Fill"/>
                    </VerticalStackLayout>
                    <HorizontalStackLayout>
                        <Grid RowDefinitions="*" ColumnDefinitions="5, 60, 620, 60, 5">
                            <ImageButton Grid.Column="1"
                        HeightRequest="58" WidthRequest="58" VerticalOptions="End" Clicked="DeleteCurrent_Clicked" HorizontalOptions="Start">
                                <ImageButton.Source>
                                    <FontImageSource
                            FontFamily="MaterialIcons"
                            Glyph="&#xe92b;"
                            Color="{AppThemeBinding Light=Red, Dark=Red}"
                            Size="24" />
                                </ImageButton.Source>
                            </ImageButton>
                            <ImageButton Grid.Column="4"
                            HeightRequest="58" WidthRequest="58" VerticalOptions="End" Clicked="ClosePopup_Clicked" HorizontalOptions="End">
                                <ImageButton.Source>
                                    <FontImageSource
                                    FontFamily="MaterialIcons"
                                    Glyph="&#xe5cd;"
                                    Color="{AppThemeBinding Light=Black, Dark=White}"
                                    Size="24" />
                                </ImageButton.Source>
                            </ImageButton>
                        </Grid>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

        </Grid>
        <Grid x:Name="PopupOverlaySettings"
            IsVisible="False"
            BackgroundColor="#80000000"
            ZIndex="10">
            <Button Clicked="ClosePopupSettings_Clicked" BackgroundColor="Transparent"></Button>
            <Border x:Name="PopupContentSettings"
            StrokeThickness="0"
            BackgroundColor="{AppThemeBinding Light=White, Dark=Black}"
            Padding="20"
            StrokeShape="RoundRectangle 12"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            WidthRequest="800">
                <VerticalStackLayout Spacing="10" >
                    <Label Text="Ustawienia" FontSize="20" HorizontalOptions="Center"/>
                    <ImageButton Grid.Column="4"
                        HeightRequest="58" WidthRequest="58" VerticalOptions="End" Clicked="ClosePopupSettings_Clicked" HorizontalOptions="End">
                        <ImageButton.Source>
                            <FontImageSource
                                FontFamily="MaterialIcons"
                                Glyph="&#xe5cd;"
                                Color="{AppThemeBinding Light=Black, Dark=White}"
                                Size="24" />
                        </ImageButton.Source>
                    </ImageButton>
                </VerticalStackLayout>
            </Border>

        </Grid>
    </Grid>

</ContentPage>