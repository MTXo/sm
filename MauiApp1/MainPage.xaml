<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.MainPage"
             >
    <Grid BackgroundColor="{AppThemeBinding Dark=#ffffff, Light=#dfdfdf}">
        <Grid ColumnDefinitions="86, *, 900"
              RowDefinitions="*, Auto"
              ColumnSpacing="5"
              RowSpacing="5">
            <Grid Grid.Column="0"
                  BackgroundColor="{AppThemeBinding Dark=#ffffff, Light=#dfdfdf}"
                  RowDefinitions="*, 82, 82"
                    RowSpacing="6">
                <Border Margin="5, 5, 0, 0" Grid.Row="0" BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#2f2f2f}" Stroke="{AppThemeBinding Light=Black, Dark=White}" StrokeShape="RoundRectangle 10" WidthRequest="80">
                    <CollectionView
                        SelectionMode="Single"
                        x:Name="AppCollectionView"
                        SelectionChanged="AppCollectionView_SelectionChanged"
                        HorizontalOptions="Start"
                        WidthRequest="72"
                        >
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <StackLayout HeightRequest="56" Padding="0,5,0,0">
                                    <Border VerticalOptions="Center" Stroke="{AppThemeBinding Light=Black, Dark=White}" StrokeShape="RoundRectangle 10" HeightRequest="48" WidthRequest="48">
                                        <Label
                                            Text="{Binding Shortcut}"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                            IsVisible="True"/>
                                    </Border>
                                </StackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
                <Border Grid.Row="1" BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#2f2f2f}" Stroke="{AppThemeBinding Light=Black, Dark=White}" StrokeShape="RoundRectangle 10" HeightRequest="80" WidthRequest="80">
                    <ImageButton
                            Aspect="AspectFit"
                            HeightRequest="65" 
                            WidthRequest="65"
                            Clicked="AddApp_Clicked"
                            BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#2f2f2f}"
                            >
                        <ImageButton.Source>
                            <FontImageSource
                                    FontFamily="MaterialIcons"
                                    Glyph="&#xe145;"
                                    Color="{AppThemeBinding Light=Black, Dark=White}"
                                    Size="24" />
                        </ImageButton.Source>
                    </ImageButton>
                </Border>
                <Border Grid.Row="2" BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#2f2f2f}" Stroke="{AppThemeBinding Light=Black, Dark=White}" StrokeShape="RoundRectangle 10" HeightRequest="80" WidthRequest="80">
                    <ImageButton
                        Aspect="AspectFit"
                        HeightRequest="65" 
                        WidthRequest="65"
                        Clicked="OpenPopupSettings_Clicked"
                        BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#2f2f2f}"
                        >
                        <ImageButton.Source>
                            <FontImageSource
                                FontFamily="MaterialIcons"
                                Glyph="&#xf522;"
                                Color="{AppThemeBinding Light=Black, Dark=White}"
                                Size="24" />
                        </ImageButton.Source>
                    </ImageButton>
                </Border>
            </Grid>
            <Border Margin="0,5,0,0" Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#2f2f2f}" Stroke="{AppThemeBinding Light=Black, Dark=White}" StrokeShape="RoundRectangle 10">
                <Grid
                RowDefinitions="Auto, *, Auto"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#0c0c0c}"
                Padding="20"
                x:Name="DetailsGrid"
                IsVisible="False">

                    <VerticalStackLayout
                        Padding="20"
                        Spacing="15">
                        <Border
                        Grid.Row="0"
                        BackgroundColor="White" 
                        HeightRequest="300" 
                        WidthRequest="200"
                        HorizontalOptions="Center"
                        Padding="0">
                            <Image
                                x:Name="gameBanner"
                                Source="https://images.squarespace-cdn.com/content/v1/618e7f223fb749481d23c9c1/8ad0b113-c63a-4db9-809a-4c3eb51122ba/foto+logo.jpg"/>
                        </Border>

                        <!-- ą, ć, ę, ł, ń, ó, ś, ź, ż -->
                        <HorizontalStackLayout>
                            <Button
                                Text="Stwórz kopię zapisów"
                                TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                BackgroundColor="{AppThemeBinding Light=#10000000, Dark=#10ffffff}"
                                Clicked="AddSave_Clicked">
                                <Button.ImageSource>
                                    <FontImageSource
                                        FontFamily="MaterialIcons"
                                        Glyph="&#xe161;"
                                        Size="24"
                                        Color="{AppThemeBinding Light=Black, Dark=White}" />
                                </Button.ImageSource>
                            </Button>
                        </HorizontalStackLayout>

                    </VerticalStackLayout>

                    <ImageButton
                        Grid.Row="1"
                        HeightRequest="58" WidthRequest="58"  VerticalOptions="End" HorizontalOptions="End" Clicked="OpenPopup_Clicked">
                        <ImageButton.Source>
                            <FontImageSource
                                FontFamily="MaterialIcons"
                                Glyph="&#xe8b8;"
                                Color="{AppThemeBinding Light=Black, Dark=White}"
                                Size="24" />
                        </ImageButton.Source>
                    </ImageButton>

                </Grid>
            </Border>
            <Border Grid.Column="2" Margin="0,5,5,0" BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#2f2f2f}" Stroke="{AppThemeBinding Light=Black, Dark=White}" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout>
                    <ScrollView>
                        <CollectionView
                            x:Name="SavesCollectionView"
                            ItemsSource="{Binding Saves}"
                            SelectionMode="Single">

                            <CollectionView.ItemTemplate>
                                
                                <DataTemplate>
                                    <Border 
                                        Margin="10,5"
                                        Padding="10"
                                        StrokeThickness="0"
                                        BackgroundColor="{AppThemeBinding Light=#f5f5f5, Dark=#1e1e1e}"
                                        StrokeShape="RoundRectangle 12">

                                        <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto">

                                            <VerticalStackLayout Grid.Row="0" Grid.Column="0">
                                                <Label 
                                                    Text="{Binding Description}" 
                                                    FontAttributes="Bold"
                                                    FontSize="16"
                                                    TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

                                                <Label 
                                                    Text="{Binding GameName}" 
                                                    FontSize="13"
                                                    TextColor="Gray"/>          
                                            </VerticalStackLayout>

                                            <Label
                                                Text="{Binding FileSize}" 
                                                Grid.Row="0" 
                                                Grid.Column="1"
                                                HorizontalOptions="End"
                                                VerticalOptions="Start"
                                                FontSize="12"
                                                TextColor="Gray"/>

                                            <Label 
                                                Text="{Binding Timestamp, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
                                                Grid.Row="1"
                                                Grid.ColumnSpan="2"
                                                FontSize="12"
                                                TextColor="Gray"/>

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                                
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </ScrollView>

                </VerticalStackLayout>
            </Border>
        </Grid>
        <Grid x:Name="PopupOverlay"
            IsVisible="False"
            BackgroundColor="#80000000"
            ZIndex="10">
            <Button Clicked="ClosePopup_Clicked" BackgroundColor="Transparent"></Button>
            <Border x:Name="PopupContent"
            StrokeThickness="0"
            BackgroundColor="{AppThemeBinding Light=White, Dark=Black}"
            Padding="20"
            StrokeShape="RoundRectangle 12"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            WidthRequest="800">
                <VerticalStackLayout Spacing="10" >
                    <Label Text="Ustawienia" FontSize="20" HorizontalOptions="Center"/>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Nazwa aplikacji: " />
                        <Entry x:Name="name_settings" Placeholder="Nazwa..." Unfocused="Name_Unfocused" HorizontalOptions="Fill"/>
                    </VerticalStackLayout>
                    <Picker x:Name="ProcessPicker" HorizontalOptions="Fill" Title="Wybierz proces..." SelectedIndexChanged="ProcessPicker_SelectedIndexChanged"/>
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Ścieżka pliku wykonywalnego: " VerticalOptions="Center"/>
                        <Entry x:Name="exePathEntry" Placeholder="Ścieżka pliku..." Unfocused="exePathEntry_Unfocused" HorizontalOptions="Fill"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Steam App ID: " VerticalOptions="Center"/>
                        <Entry x:Name="steamAID" Placeholder="Steam APP ID..." Unfocused="steamAIDEntry_Unfocused" HorizontalOptions="Fill"/>
                    </VerticalStackLayout>
                    <HorizontalStackLayout>
                        <Grid RowDefinitions="*" ColumnDefinitions="5, 60, 620, 60, 5">
                            <ImageButton Grid.Column="1"
                        HeightRequest="58" WidthRequest="58" VerticalOptions="End" Clicked="DeleteCurrent_Clicked" HorizontalOptions="Start">
                                <ImageButton.Source>
                                    <FontImageSource
                            FontFamily="MaterialIcons"
                            Glyph="&#xe92b;"
                            Color="{AppThemeBinding Light=Red, Dark=Red}"
                            Size="24" />
                                </ImageButton.Source>
                            </ImageButton>
                            <ImageButton Grid.Column="4"
                            HeightRequest="58" WidthRequest="58" VerticalOptions="End" Clicked="ClosePopup_Clicked" HorizontalOptions="End">
                                <ImageButton.Source>
                                    <FontImageSource
                                    FontFamily="MaterialIcons"
                                    Glyph="&#xe5cd;"
                                    Color="{AppThemeBinding Light=Black, Dark=White}"
                                    Size="24" />
                                </ImageButton.Source>
                            </ImageButton>
                        </Grid>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

        </Grid>
        <Grid x:Name="PopupOverlaySettings"
            IsVisible="False"
            BackgroundColor="#80000000"
            ZIndex="10">
            <Button Clicked="ClosePopupSettings_Clicked" BackgroundColor="Transparent"></Button>
            <Border x:Name="PopupContentSettings"
            StrokeThickness="0"
            BackgroundColor="{AppThemeBinding Light=White, Dark=Black}"
            Padding="20"
            StrokeShape="RoundRectangle 12"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            WidthRequest="800">
                <VerticalStackLayout Spacing="10" >
                    <Label Text="Ustawienia" FontSize="20" HorizontalOptions="Center"/>
                    <ImageButton Grid.Column="4"
                        HeightRequest="58" WidthRequest="58" VerticalOptions="End" Clicked="ClosePopupSettings_Clicked" HorizontalOptions="End">
                        <ImageButton.Source>
                            <FontImageSource
                                FontFamily="MaterialIcons"
                                Glyph="&#xe5cd;"
                                Color="{AppThemeBinding Light=Black, Dark=White}"
                                Size="24" />
                        </ImageButton.Source>
                    </ImageButton>
                </VerticalStackLayout>
            </Border>

        </Grid>
    </Grid>

</ContentPage>